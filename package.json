{
  "name": "mediator",
  "version": "0.0.1",
  "private": true,
  "description": "Mediator — personal AI-to-workspace bridge. TypeScript-first, local-first, fail-closed.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/provider-adapters/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "dependency-cruiser": "^16.3.0"
  }
}
