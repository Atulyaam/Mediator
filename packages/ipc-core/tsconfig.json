{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@mediator/shared-contracts": ["../../packages/shared-contracts/dist/index.d.ts"],
      "@mediator/protocol": ["../../packages/protocol/dist/index.d.ts"],
      "@mediator/content-transfer": ["../../packages/content-transfer/dist/index.d.ts"],
      "@mediator/persistence": ["../../packages/persistence/dist/index.d.ts"]
    }
  },
  "references": [
    { "path": "../../packages/shared-contracts" },
    { "path": "../../packages/protocol" },
    { "path": "../../packages/content-transfer" },
    { "path": "../../packages/persistence" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
