{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@mediator/shared-contracts": ["../../packages/shared-contracts/dist/index.d.ts"],
      "@mediator/task-domain": ["../../packages/task-domain/dist/index.d.ts"],
      "@mediator/workspace-boundary": ["../../packages/workspace-boundary/dist/index.d.ts"],
      "@mediator/context-security": ["../../packages/context-security/dist/index.d.ts"],
      "@mediator/policy-engine": ["../../packages/policy-engine/dist/index.d.ts"],
      "@mediator/context-engine": ["../../packages/context-engine/dist/index.d.ts"],
      "@mediator/stage-store": ["../../packages/stage-store/dist/index.d.ts"],
      "@mediator/persistence": ["../../packages/persistence/dist/index.d.ts"],
      "@mediator/ide-adapter-vscode": ["../../packages/ide-adapter-vscode/dist/index.d.ts"],
      "@mediator/ide-adapter-antigravity": ["../../packages/ide-adapter-antigravity/dist/index.d.ts"]
    }
  },
  "references": [
    { "path": "../../packages/shared-contracts" },
    { "path": "../../packages/task-domain" },
    { "path": "../../packages/workspace-boundary" },
    { "path": "../../packages/context-security" },
    { "path": "../../packages/policy-engine" },
    { "path": "../../packages/context-engine" },
    { "path": "../../packages/stage-store" },
    { "path": "../../packages/persistence" },
    { "path": "../../packages/ide-adapter-vscode" },
    { "path": "../../packages/ide-adapter-antigravity" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
