{
  "name": "@mediator/ide-adapter-vscode",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@mediator/shared-contracts": "*",
    "@mediator/workspace-boundary": "*",
    "@mediator/context-security": "*"
  },
  "devDependencies": {
    "@mediator/context-engine": "*",
    "@mediator/ide-adapter-antigravity": "*",
    "@types/node": "^22.5.0",
    "typescript": "*",
    "vitest": "*"
  }
}
